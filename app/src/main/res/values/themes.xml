<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme. All actual colors are drawn in Compose; XML only needs to
         give the window an OLED-black background and chrome-free decorations. -->
    <style name="Theme.LiquidPrismClock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/oled_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowActivityTransitions">false</item>
    </style>
</resources>
